# Server runtime configuration
# Copy this file to src/mcp_gee_sweet/.env and uncomment/set values as needed.
# Env vars already set in the environment take precedence over this file.

# Logging level: DEBUG | INFO | WARNING | ERROR (unset = no extra logging)
# Controls mcp_gee_sweet package logs and uvicorn access logs.
DEBUG_LEVEL=DEBUG

# Log file — when set alongside DEBUG_LEVEL, server writes logs here in addition to stderr.
# Required for local SSE (Claude Code CLI drops MCP server stderr). Optional for Docker.
LOG_FILE=/tmp/mcp-gee-sweet.log

# HTTP access log file — when set alongside DEBUG_LEVEL, uvicorn access logs also write here.
# Use for local SSE; tailed with `make access-logs`.
ACCESS_LOG_FILE=/tmp/mcp-gee-sweet-access.log

# Auth method: oauth | service_account | adc  (default: auto-detect waterfall)
# AUTH_METHOD=

# SSE only: seconds to wait for the browser OAuth consent when there's no usable
# token, before starting without Google access (stdio never runs the consent;
# use `mcp-gee-sweet auth`).
# OAUTH_CONSENT_TIMEOUT_SECONDS=300

# Restrict which tools are registered — comma-separated function names.
# Default: all tools enabled.
# ENABLED_TOOLS=

# Which local files tools may read and write: full | roots | off
# Default: full under stdio, off under SSE and streamable HTTP. The server's own
# credential, config, cache and log files are refused in every mode. In off mode,
# tools that only work on local files (sync_folder, upload_local_file, ...) aren't
# registered. See docs/configuration.md "Local file access".
# LOCAL_FILE_ACCESS=
# With LOCAL_FILE_ACCESS=roots: the allowed directories, separated by ":" (";" on Windows).
# LOCAL_FILE_ROOTS=

# Server network (SSE/HTTP transport only)
# Default: 127.0.0.1 (this machine only). Any other address needs MCP_SERVER_TOKEN,
# or the server refuses to start.
# HOST=127.0.0.1
# PORT=8000

# Bearer token every SSE/HTTP request must send as "Authorization: Bearer <token>".
# Generate a long random value, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Unset or blank: only connections to a loopback HOST that name a loopback Host
# header (localhost or a loopback IP) are served, and a non-loopback HOST refuses
# to start. Docker Compose reads it from the .env next to docker-compose.yml, or
# from this file if that one doesn't set it.
# MCP_SERVER_TOKEN=
# Serve a non-loopback HOST with no token, only behind a reverse proxy that does its own
# authentication. Accepts 1 or true; any other value stops the server at startup.
# Does nothing on a loopback HOST, and is ignored when MCP_SERVER_TOKEN is set.
# ALLOW_UNAUTHENTICATED_HTTP=

# Cache
# CACHE_TTL=1800   # also adjustable at runtime via the set_cache_ttl tool, no restart needed
# Default: the user's cache directory, e.g. ~/.cache/mcp-gee-sweet/cache.db
# (see docs/configuration.md). ":memory:" keeps no file.
# CACHE_DB_PATH=/path/to/cache.db
# Validate sheet/doc cache hits against Drive's modifiedTime before serving them
# (one extra Drive API call per lookup). Disable if that overhead isn't worth it
# for your usage pattern.
# CACHE_VALIDATE_MODIFIED_TIME=true

# Safety cap on response size, in characters, for tools that can return large inline
# payloads — see docs/configuration.md for the current default and tool list. Raise
# to match a raised MAX_MCP_OUTPUT_TOKENS in your MCP client, or lower it if your
# client lacks Claude Code's graceful overflow-to-file handling (see
# docs/decisions/decision-response-size-cap-reevaluation-519.md).
# MAX_TOOL_RESPONSE_CHARS=

# Most calendars list_all_events queries at once, shared across every concurrent
# list_all_events call on the server (Calendar API per-user rate limit). Raise for
# faster fan-out over many calendars; lower for a stricter rate-limit posture.
# LIST_ALL_EVENTS_MAX_CONCURRENCY=20

# Seconds one socket operation of a Google API request (connect, send, or a wait for
# data) may block before the request fails. Per operation, not per request, so a long
# transfer that keeps moving data never hits it. Raise it if Google legitimately takes
# longer to start answering, such as a very large export (see docs/configuration.md).
# HTTP_TIMEOUT_SECONDS=60

# QA OAuth automation (scripts/oauth_setup.py — see docs/qa/playwright_oauth.md)
# GOOGLE_TEST_EMAIL=
# GOOGLE_TEST_PASSWORD=
# GOOGLE_OAUTH_REFRESH_TOKEN=   # CI: reconstructs token.json without browser flow
# GOOGLE_OAUTH_CLIENT_ID=       # from credentials.json → installed.client_id
# GOOGLE_OAUTH_CLIENT_SECRET=   # from credentials.json → installed.client_secret
