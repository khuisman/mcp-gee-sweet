# Server runtime configuration
# Copy this file to src/mcp_gee_sweet/.env and uncomment/set values as needed.
# Env vars already set in the environment take precedence over this file.

# Logging level: DEBUG | INFO | WARNING | ERROR (unset = no extra logging)
# Controls mcp_gee_sweet package logs and uvicorn access logs.
DEBUG_LEVEL=DEBUG

# Log file — when set alongside DEBUG_LEVEL, server writes logs here in addition to stderr.
# Required for local SSE (Claude Code CLI drops MCP server stderr). Optional for Docker.
LOG_FILE=/tmp/mcp-gee-sweet.log

# HTTP access log file — when set alongside DEBUG_LEVEL, uvicorn access logs also write here.
# Use for local SSE; tailed with `make access-logs`.
ACCESS_LOG_FILE=/tmp/mcp-gee-sweet-access.log

# Auth method: oauth | service_account | adc  (default: auto-detect waterfall)
# AUTH_METHOD=

# Restrict which tools are registered — comma-separated function names.
# Default: all tools enabled.
# ENABLED_TOOLS=

# Server network (SSE/HTTP transport only)
# HOST=0.0.0.0
# PORT=8000

# Cache
# CACHE_TTL=1800
# CACHE_DB_PATH=/tmp/mcp_gee_sweet.db
